# ─────────────────────────────────────────────────────────────────────────────
# Presentation requests — configure ONE receiver. With neither configured the
# booking form stays visible but clearly unavailable, and /api/presentation
# answers 503. Set these in Vercel → Project → Settings → Environment Variables
# (Production, and Preview if you want to test there). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Option A — email through Resend (https://resend.com)
# BOOKING_FROM_EMAIL must use a domain verified in your Resend account. For a
# quick test you may use "Kangen Water PH <onboarding@resend.dev>", which Resend
# only delivers to the email address that owns the Resend account.
RESEND_API_KEY=
BOOKING_TO_EMAIL=            # one address, or several separated by commas
BOOKING_FROM_EMAIL=

# Option B — HTTPS webhook (Google Apps Script, Make, Zapier, a CRM endpoint…)
# Receives a JSON POST. Must answer 2xx, and not an HTML page or {"ok":false},
# for the visitor to see success. Google Sheet receiver: docs/booking-webhook.md
# (its URL ends in /exec?token=…).
BOOKING_WEBHOOK_URL=
# Optional: when set, each request carries X-Signature-SHA256 = HMAC-SHA256(body)
BOOKING_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Development only — never set on Vercel. Renders a labelled procedural
# stand-in (NOT the K8) to test the 3D model path. See docs/3d-model-upgrade.md.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_K8_DEV_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional — canonical origin. Leave empty on Vercel: the build uses the
# project's real production domain (VERCEL_PROJECT_PRODUCTION_URL).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
